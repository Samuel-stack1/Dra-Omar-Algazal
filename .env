# Banco de dados temporário para que o Next.js e o Prisma não apresentem erro na tela
# Quando for para produção, você substituirá por uma URL real do Supabase
DATABASE_URL="postgresql://usuario:senha@localhost:5432/bancofalso"

# Senha de integração com o Soro (Substitua por uma forte em produção)
SORO_SECRET="senha-temporaria"
